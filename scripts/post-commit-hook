#!/bin/bash -e

source ./scripts/get_next_version.sh

CURRENT_BRANCH=$(git branch --show-current)
MAIN_BRANCH=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')
if [[ "$CURRENT_BRANCH" == "$MAIN_BRANCH" ]]; then
    # Lightweight tag, like all existing version tags. A global tag.gpgSign=true would
    # otherwise make this a signed annotated tag that fails with "no tag message?".
    git -c tag.gpgSign=false tag "$VITE_PRACTICE_VERSION"
    git push origin "$VITE_PRACTICE_VERSION"
else
    echo "skipping git tag from branch $CURRENT_BRANCH"
fi
